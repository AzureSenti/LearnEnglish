<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@color/bg_color">

    <!-- Header / Toolbar area -->
    <TextView android:id="@+id/tv_profile_title" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginStart="24dp"
        android:layout_marginTop="24dp" android:fontFamily="sans-serif-black" tools:text="Profile"
        android:textColor="@color/text_primary" android:textSize="24sp"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <ImageView android:id="@+id/iv_settings" android:layout_width="28dp"
        android:layout_height="28dp" android:layout_marginEnd="24dp"
        android:contentDescription="@null" android:src="@android:drawable/ic_menu_preferences"
        app:layout_constraintBottom_toBottomOf="@id/tv_profile_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_profile_title" app:tint="@color/text_secondary" />

    <!-- User Information Section -->
    <com.google.android.material.imageview.ShapeableImageView android:id="@+id/iv_user_avatar"
        android:layout_width="100dp" android:layout_height="100dp" android:layout_marginTop="32dp"
        android:padding="4dp" android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_profile_title"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.SmallComponent"
        app:strokeColor="@color/white" app:strokeWidth="4dp" tools:src="@tools:sample/avatars" />

    <TextView android:id="@+id/tv_full_name" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-medium" tools:text="Alex"
        android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_user_avatar" />

    <LinearLayout android:id="@+id/layout_level_tag" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:background="@drawable/bg_chip_selected"
        android:backgroundTint="@color/chip_level_bg" android:gravity="center"
        android:orientation="horizontal" android:paddingHorizontal="16dp"
        android:paddingVertical="6dp" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_full_name">

        <ImageView android:layout_width="16dp" android:layout_height="16dp"
            android:layout_marginEnd="8dp" android:src="@drawable/ic_accessibility"
            app:tint="@color/chip_level_text" />

        <TextView android:id="@+id/tv_english_level" android:layout_width="wrap_content"
            android:layout_height="wrap_content" tools:text="C1 Advanced"
            android:textColor="@color/chip_level_text" android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Stats Cards Grid -->
    <LinearLayout android:id="@+id/layout_stats" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="32dp"
        android:orientation="horizontal" android:paddingHorizontal="16dp" android:weightSum="3"
        app:layout_constraintTop_toBottomOf="@id/layout_level_tag">

        <!-- Streak Card -->
        <com.google.android.material.card.MaterialCardView android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_margin="8dp"
            android:layout_weight="1" app:cardCornerRadius="16dp" app:cardElevation="0dp"
            app:strokeColor="@color/border_color" app:strokeWidth="1dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:orientation="vertical" android:padding="12dp">

                <ImageView android:layout_width="40dp" android:layout_height="40dp"
                    android:background="@drawable/bg_circle_light_blue" android:padding="10dp"
                    android:src="@drawable/ic_fire" app:tint="@color/blue_primary" />

                <TextView android:id="@+id/tv_streak_count" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    tools:text="15" android:textColor="@color/text_primary" android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    tools:text="Days\nStreak" android:gravity="center"
                    android:textColor="@color/text_secondary" android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Study Time Card -->
        <com.google.android.material.card.MaterialCardView android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_margin="8dp"
            android:layout_weight="1" app:cardCornerRadius="16dp" app:cardElevation="0dp"
            app:strokeColor="@color/border_color" app:strokeWidth="1dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:orientation="vertical" android:padding="12dp">

                <ImageView android:layout_width="40dp" android:layout_height="40dp"
                    android:background="@drawable/bg_circle_light_blue" android:padding="10dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    app:tint="@color/blue_primary" />

                <TextView android:id="@+id/tv_study_time_count" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    tools:text="12.5h" android:textColor="@color/text_primary"
                    android:textSize="18sp" android:textStyle="bold" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    tools:text="Study\nTime" android:gravity="center"
                    android:textColor="@color/text_secondary" android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Words Mastered Card -->
        <com.google.android.material.card.MaterialCardView android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_margin="8dp"
            android:layout_weight="1" app:cardCornerRadius="16dp" app:cardElevation="0dp"
            app:strokeColor="@color/border_color" app:strokeWidth="1dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:orientation="vertical" android:padding="12dp">

                <ImageView android:layout_width="40dp" android:layout_height="40dp"
                    android:background="@drawable/bg_circle_light_blue" android:padding="10dp"
                    android:src="@drawable/ic_library" app:tint="@color/blue_primary" />

                <TextView android:id="@+id/tv_words_mastered_count"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" tools:text="450"
                    android:textColor="@color/text_primary" android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    tools:text="Words\nMastered" android:gravity="center"
                    android:textColor="@color/text_secondary" android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Memory Levels Section -->
    <com.google.android.material.card.MaterialCardView android:id="@+id/card_memory_levels"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp" android:layout_marginTop="16dp"
        app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeColor="@color/border_color"
        app:strokeWidth="1dp" app:layout_constraintTop_toBottomOf="@id/layout_stats">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">

                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@drawable/ic_explore" app:tint="@color/blue_primary" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" tools:text="Memory Levels"
                    android:textColor="@color/text_primary" android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Dynamic Chart Container -->
            <FrameLayout android:id="@+id/layout_memory_chart" android:layout_width="match_parent"
                android:layout_height="140dp" android:layout_marginTop="16dp" />

            <TextView android:id="@+id/tv_chart_description" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:gravity="center"
                tools:text="Your spaced repetition schedule is well optimized."
                android:textColor="@color/text_secondary" android:textSize="13sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Badges Section -->
    <TextView android:id="@+id/tv_badges_title" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginStart="24dp"
        android:layout_marginTop="24dp" tools:text="My Badges"
        android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_memory_levels" />

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_badges"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:clipToPadding="false"
        android:orientation="horizontal" android:paddingHorizontal="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/tv_badges_title"
        tools:listitem="@layout/item_badge_placeholder" />

</androidx.constraintlayout.widget.ConstraintLayout>