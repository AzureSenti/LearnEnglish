<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============== Typography ============== -->
    <!-- Headings use Lexend, body uses Inter (declared in res/font) -->

    <style name="TextAppearance.3English.Display" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/lexend</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.3English.H1" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/lexend</item>
        <item name="android:textSize">@dimen/text_h1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.3English.H2" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/lexend</item>
        <item name="android:textSize">@dimen/text_h2</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.3English.H3" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/lexend</item>
        <item name="android:textSize">@dimen/text_h3</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.3English.BodyLg" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">@dimen/text_body_lg</item>
        <item name="android:lineSpacingMultiplier">1.6</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <style name="TextAppearance.3English.BodyMd" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">@dimen/text_body_md</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <style name="TextAppearance.3English.LabelSm" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">@dimen/text_label_sm</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.3English.Caption" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <!-- ============== Reusable widget styles ============== -->

    <style name="Widget.3English.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/input_height</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">52dp</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
        <item name="android:textColor">@color/on_background</item>
        <item name="android:textColorHint">@color/outline</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">@dimen/text_body_lg</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Widget.3English.EditText.Error" parent="Widget.3English.EditText">
        <item name="android:background">@drawable/bg_input_error</item>
        <item name="android:textColor">@color/error</item>
        <item name="android:textColorHint">@color/error</item>
    </style>

    <style name="Widget.3English.Button.Primary" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">@dimen/text_label_sm</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="Widget.3English.Button.Secondary" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/on_secondary</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">@dimen/text_label_sm</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="Widget.3English.Button.Skip" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_skip_button</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">@dimen/text_label_sm</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
        <item name="android:paddingTop">@dimen/space_sm</item>
        <item name="android:paddingBottom">@dimen/space_sm</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <!-- ShapeableImageView / MaterialCardView: chỉ bo góc trên (dùng với app:shapeAppearanceOverlay) -->
    <style name="RoundedTopCorners">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/card_corner_large</item>
        <item name="cornerSizeTopRight">@dimen/card_corner_large</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="HeaderTitle">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="CircleImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50dp</item>
    </style>
</resources>
