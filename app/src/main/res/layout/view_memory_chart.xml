<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/space_md">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chart_bars_container"
        android:layout_width="0dp"
        android:layout_height="@dimen/sanctuary_chart_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/bar_l1"
            android:layout_width="@dimen/sanctuary_chart_bar_width"
            android:layout_height="36dp"
            android:background="@drawable/bar_memory_inactive"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/bar_l2"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent" />

        <View
            android:id="@+id/bar_l2"
            android:layout_width="@dimen/sanctuary_chart_bar_width"
            android:layout_height="44dp"
            android:background="@drawable/bar_memory_inactive"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/bar_l3"
            app:layout_constraintStart_toEndOf="@id/bar_l1" />

        <View
            android:id="@+id/bar_l3"
            android:layout_width="@dimen/sanctuary_chart_bar_width"
            android:layout_height="58dp"
            android:background="@drawable/bar_memory_inactive"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/bar_l4"
            app:layout_constraintStart_toEndOf="@id/bar_l2" />

        <View
            android:id="@+id/bar_l4"
            android:layout_width="@dimen/sanctuary_chart_bar_active_width"
            android:layout_height="96dp"
            android:background="@drawable/bar_memory_active"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/bar_l5"
            app:layout_constraintStart_toEndOf="@id/bar_l3" />

        <View
            android:id="@+id/bar_l5"
            android:layout_width="@dimen/sanctuary_chart_bar_width"
            android:layout_height="72dp"
            android:background="@drawable/bar_memory_inactive"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/bar_l6"
            app:layout_constraintStart_toEndOf="@id/bar_l4" />

        <View
            android:id="@+id/bar_l6"
            android:layout_width="@dimen/sanctuary_chart_bar_width"
            android:layout_height="84dp"
            android:background="@drawable/bar_memory_inactive"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/bar_l7"
            app:layout_constraintStart_toEndOf="@id/bar_l5" />

        <View
            android:id="@+id/bar_l7"
            android:layout_width="@dimen/sanctuary_chart_bar_width"
            android:layout_height="64dp"
            android:background="@drawable/bar_memory_inactive"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/bar_l6" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/label_l1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/inter"
        android:text="L1"
        android:textColor="@color/sanctuary_text_secondary"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="@id/bar_l1"
        app:layout_constraintStart_toStartOf="@id/bar_l1"
        app:layout_constraintTop_toBottomOf="@id/chart_bars_container" />

    <TextView
        android:id="@+id/label_l2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter"
        android:text="L2"
        android:textColor="@color/sanctuary_text_secondary"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="@id/bar_l2"
        app:layout_constraintStart_toStartOf="@id/bar_l2"
        app:layout_constraintTop_toTopOf="@id/label_l1" />

    <TextView
        android:id="@+id/label_l3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter"
        android:text="L3"
        android:textColor="@color/sanctuary_text_secondary"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="@id/bar_l3"
        app:layout_constraintStart_toStartOf="@id/bar_l3"
        app:layout_constraintTop_toTopOf="@id/label_l1" />

    <TextView
        android:id="@+id/label_l4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter"
        android:text="L4"
        android:textColor="@color/sanctuary_primary_blue"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/bar_l4"
        app:layout_constraintStart_toStartOf="@id/bar_l4"
        app:layout_constraintTop_toTopOf="@id/label_l1" />

    <TextView
        android:id="@+id/label_l5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter"
        android:text="L5"
        android:textColor="@color/sanctuary_text_secondary"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="@id/bar_l5"
        app:layout_constraintStart_toStartOf="@id/bar_l5"
        app:layout_constraintTop_toTopOf="@id/label_l1" />

    <TextView
        android:id="@+id/label_l6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter"
        android:text="L6"
        android:textColor="@color/sanctuary_text_secondary"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="@id/bar_l6"
        app:layout_constraintStart_toStartOf="@id/bar_l6"
        app:layout_constraintTop_toTopOf="@id/label_l1" />

    <TextView
        android:id="@+id/label_l7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter"
        android:text="L7"
        android:textColor="@color/sanctuary_text_secondary"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="@id/bar_l7"
        app:layout_constraintStart_toStartOf="@id/bar_l7"
        app:layout_constraintTop_toTopOf="@id/label_l1" />

    <View
        android:id="@+id/memory_chart_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/sanctuary_card_stroke"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/label_l1" />

    <TextView
        android:id="@+id/tv_memory_footer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/inter"
        android:text="@string/avg_mastery"
        android:textColor="@color/sanctuary_text_secondary"
        android:textSize="13sp"
        app:layout_constraintEnd_toStartOf="@id/iv_memory_info"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/memory_chart_divider" />

    <ImageView
        android:id="@+id/iv_memory_info"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@string/cd_info"
        android:src="@drawable/ic_info_outline"
        app:layout_constraintBottom_toBottomOf="@id/tv_memory_footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_memory_footer" />

</androidx.constraintlayout.widget.ConstraintLayout>
