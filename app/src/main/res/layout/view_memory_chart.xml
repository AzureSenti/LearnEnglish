<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/space_md">

    <!-- MPAndroidChart BarChart: Thành phần này thay thế cho toàn bộ các View vẽ tay trước đó -->
    <com.github.mikephil.charting.charts.BarChart
        android:id="@+id/memory_bar_chart"
        android:layout_width="0dp"
        android:layout_height="@dimen/sanctuary_chart_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/memory_chart_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/sanctuary_card_stroke"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/memory_bar_chart" />

    <TextView
        android:id="@+id/tv_memory_footer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/inter"
        android:text="@string/avg_mastery"
        android:textColor="@color/sanctuary_text_secondary"
        android:textSize="13sp"
        app:layout_constraintEnd_toStartOf="@id/iv_memory_info"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/memory_chart_divider" />

    <ImageView
        android:id="@+id/iv_memory_info"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@string/cd_info"
        android:src="@drawable/ic_info_outline"
        app:layout_constraintBottom_toBottomOf="@id/tv_memory_footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_memory_footer" />

</androidx.constraintlayout.widget.ConstraintLayout>
