<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sanctuary_background"
    tools:context=".feature.mainmenu.MainMenuActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/sanctuary_horizontal_padding"
            android:paddingTop="@dimen/space_md"
            android:paddingEnd="@dimen/sanctuary_horizontal_padding"
            android:paddingBottom="@dimen/space_lg">

            <!-- Top bar -->
            <ImageView
                android:id="@+id/btn_menu"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/cd_menu"
                android:src="@drawable/ic_menu"
                app:layout_constraintBottom_toBottomOf="@id/tv_app_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_app_title"
                app:tint="@color/sanctuary_text_primary" />

            <TextView
                android:id="@+id/tv_app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/lexend"
                android:text="@string/sanctuary_title"
                android:textColor="@color/sanctuary_primary_blue"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/btn_menu"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/streak_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_streak_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                app:layout_constraintBottom_toBottomOf="@id/tv_app_title"
                app:layout_constraintEnd_toStartOf="@id/iv_profile"
                app:layout_constraintTop_toTopOf="@id/tv_app_title">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_flame"
                    app:tint="@color/sanctuary_accent_orange" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/inter"
                    android:text="15"
                    android:textColor="@color/sanctuary_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_profile"
                android:layout_width="@dimen/sanctuary_profile_size"
                android:layout_height="@dimen/sanctuary_profile_size"
                android:contentDescription="@string/cd_profile"
                android:scaleType="centerCrop"
                android:src="@drawable/profile_placeholder"
                app:layout_constraintBottom_toBottomOf="@id/tv_app_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_app_title"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:strokeColor="@color/sanctuary_card_stroke"
                app:strokeWidth="1dp" />

            <!-- Greeting -->
            <TextView
                android:id="@+id/tv_welcome_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/inter"
                android:text="@string/welcome_back"
                android:textColor="@color/sanctuary_text_secondary"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_app_title" />

            <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/lexend"
                android:text="@string/greeting"
                android:textColor="@color/sanctuary_text_primary"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_welcome_back" />

            <!-- Today's Goals header -->
            <TextView
                android:id="@+id/tv_goals_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/lexend"
                android:text="@string/todays_goals"
                android:textColor="@color/sanctuary_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_greeting" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_view_all_goals"
                style="@style/Widget.3English.Button.TextLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/view_all"
                android:textColor="@color/sanctuary_primary_blue"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/tv_goals_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_goals_title" />

            <!-- Daily Review card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_daily_review"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_goals_title">

                <FrameLayout
                    android:id="@+id/icon_review_container"
                    android:layout_width="@dimen/sanctuary_icon_container_size"
                    android:layout_height="@dimen/sanctuary_icon_container_size"
                    android:background="@drawable/bg_icon_container_green"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_rebase_edit" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_daily_review_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/lexend"
                    android:text="@string/daily_review"
                    android:textColor="@color/sanctuary_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/icon_review_container"
                    app:layout_constraintTop_toTopOf="@id/icon_review_container" />

                <TextView
                    android:id="@+id/tv_daily_review_subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter"
                    android:text="@string/words_due"
                    android:textColor="@color/sanctuary_text_secondary"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tv_daily_review_title"
                    app:layout_constraintTop_toBottomOf="@id/tv_daily_review_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_start_review"
                    style="@style/Widget.3English.Button.Sanctuary.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/sanctuary_goal_button_height"
                    android:layout_marginTop="16dp"
                    android:text="@string/start_review"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/icon_review_container" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Learn New card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_learn_new"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_daily_review">

                <FrameLayout
                    android:id="@+id/icon_learn_container"
                    android:layout_width="@dimen/sanctuary_icon_container_size"
                    android:layout_height="@dimen/sanctuary_icon_container_size"
                    android:background="@drawable/bg_icon_container_blue"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_add_circle" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_learn_new_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/lexend"
                    android:text="@string/learn_new"
                    android:textColor="@color/sanctuary_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/icon_learn_container"
                    app:layout_constraintTop_toTopOf="@id/icon_learn_container" />

                <TextView
                    android:id="@+id/tv_learn_new_subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter"
                    android:text="@string/new_words"
                    android:textColor="@color/sanctuary_text_secondary"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tv_learn_new_title"
                    app:layout_constraintTop_toBottomOf="@id/tv_learn_new_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_learn_now"
                    style="@style/Widget.3English.Button.Sanctuary.Primary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/sanctuary_goal_button_height"
                    android:layout_marginTop="16dp"
                    android:text="@string/learn_now"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/icon_learn_container" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Memory Levels -->
            <TextView
                android:id="@+id/tv_memory_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/lexend"
                android:text="@string/memory_levels"
                android:textColor="@color/sanctuary_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_learn_new" />

            <FrameLayout
                android:id="@+id/card_memory_chart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_bg"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_memory_title">

                <include layout="@layout/view_memory_chart" />
            </FrameLayout>

            <!-- Study Time -->
            <TextView
                android:id="@+id/tv_study_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/lexend"
                android:text="@string/study_time"
                android:textColor="@color/sanctuary_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_memory_chart" />

            <FrameLayout
                android:id="@+id/card_study_chart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_bg"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_study_title">

                <include layout="@layout/view_study_chart" />
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="@dimen/nav_height"
        android:background="@color/white"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/nav_explore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/nav_explore"
                android:src="@drawable/ic_explore"
                app:tint="@color/sanctuary_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="@string/nav_explore"
                android:textColor="@color/sanctuary_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_library"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/nav_library"
                android:src="@drawable/ic_library"
                app:tint="@color/sanctuary_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="@string/nav_library"
                android:textColor="@color/sanctuary_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_learn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_nav_active_pill"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/nav_learn"
                    android:src="@drawable/ic_learn"
                    app:tint="@color/sanctuary_primary_blue" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="@string/nav_learn"
                    android:textColor="@color/sanctuary_primary_blue"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_profile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/nav_profile"
                android:src="@drawable/ic_profile"
                app:tint="@color/sanctuary_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="@string/nav_profile"
                android:textColor="@color/sanctuary_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
